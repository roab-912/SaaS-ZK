PORT=3000
APP_URL=http://localhost:3000
BILLING_MODE=demo
# demo is local-only and refused in production.
# For real Stripe test subscriptions: BILLING_MODE=stripe
STRIPE_SECRET_KEY=
# Existing installations may keep STRIPE_PRICE_ID for Essential:
STRIPE_PRICE_ID=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
# Explicit opt-in required for live payments:
ALLOW_LIVE_PAYMENTS=false
# Comma-separated account IDs allowed to access administration and manage issuers:
# Find your account ID in Mon abonnement after registration:
ADMIN_USER_IDS=

# Persistent SQLite file and bind address:
DB_PATH=data/clair.sqlite
HOST=127.0.0.1

# Stripe Checkout grants one 30-day trial per account, for either plan.
# A payment method is required; signup alone never activates an account.
# Local webhook: stripe listen --forward-to http://localhost:3000/api/billing/webhook
