{
  "name": "clair-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs --production",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "node server/index.mjs --built",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:built": "playwright test --config playwright.built.config.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "test:offline": "npm run build:offline && vitest run --config vitest.offline.config.mjs",
    "build:ubl": "node scripts/build-ubl-assets.mjs",
    "audit:dependencies": "npm audit --audit-level=low",
    "test:security": "vitest run tests/security-audit.test.mjs tests/security-dependencies.test.mjs tests/server/audit.test.mjs tests/server/runtime-policy.test.mjs tests/server/security.test.mjs tests/server/config.test.mjs tests/server/passwords.test.mjs tests/server/routes/issuers.test.mjs tests/server/routes/billing.test.mjs tests/zk/noir/compiler.test.mjs tests/zk/noir/compile-path.test.mjs tests/zk/noir/compile-worker.test.mjs"
  },
  "dependencies": {
    "@aztec/bb.js": "0.87.0",
    "@noir-lang/acvm_js": "1.0.0-beta.9",
    "@noir-lang/noir_js": "1.0.0-beta.9",
    "@noir-lang/noir_wasm": "1.0.0-beta.9",
    "@noir-lang/noirc_abi": "1.0.0-beta.9",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.0",
    "buffer": "^6.0.3",
    "circom2": "0.2.23",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "fflate": "0.8.3",
    "helmet": "^8.1.0",
    "libxml2-wasm": "0.7.2",
    "lucide-react": "^1.65.0",
    "process": "0.11.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "saxes": "6.0.0",
    "snarkjs": "0.7.6",
    "stripe": "^18.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@rollup/plugin-inject": "5.0.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "vite": "^7.1.0",
    "vitest": "4.1.12",
    "xslt3": "2.7.0"
  },
  "overrides": {
    "underscore": "1.13.8",
    "minimatch": "11.0.1",
    "filelist": "2.0.2"
  }
}
